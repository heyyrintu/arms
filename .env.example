# Development-only fictional preview. Production always excludes sample jobs.
NEXT_PUBLIC_DEMO_MODE=true
# Keep false until the launch checklist has been completed.
NEXT_PUBLIC_SITE_LAUNCH_READY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bootstrap/migration database; never use a privileged login as app runtime.
# DATABASE_URL=
# DATABASE_SSH_USER=ubuntu
# DATABASE_SSH_KEY_PATH= # defaults to ~/.ssh/arms-lightsail-ap-south-1.pem

# Amazon Lightsail private CV bucket. NAME only, not its domain or a URL.
# AWS_REGION=ap-south-1
# S3_PRIVATE_CV_BUCKET=
# Production: attached Lightsail instance uses SDK instance credentials.
# Local access only if separate bucket credentials are approved/provisioned:
# LIGHTSAIL_BUCKET_ACCESS_KEY_ID=
# LIGHTSAIL_BUCKET_SECRET_ACCESS_KEY=

# Staff sign-in is explicitly disabled until schema, accounts and SES are ready.
STAFF_AUTH_ENABLED=false
# Restricted runtime role; must not be the bootstrap/owner account.
# STAFF_DATABASE_URL=
# APP_BASE_URL=http://localhost:3000 # approved HTTPS origin required in production
# STAFF_AUTH_HMAC_SECRET= # 32 random bytes, base64url; server-only
# Optional development-only password sign-in; production ignores this switch.
# STAFF_DEV_SKIP_EMAIL_CODE=true

# Amazon SES. Verify the sender in the same region and approve production access.
# SES_REGION=ap-south-1
# SES_FROM_EMAIL=
# Use narrowly scoped SES credentials, separate from Lightsail bucket keys.
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# Alternatively use an explicitly provisioned workload role with SES permissions.
# Rate-limit/abuse prevention for future PUBLIC submission flows remains pending.
# RATE_LIMIT_REDIS_URL=
